# Copy to .env on the server and fill in. Never commit the real .env.
# --- Domain and HTTPS (Caddy obtains a certificate automatically) ---
FOODO_DOMAIN=foodo.example.ru
FOODO_SITE_URL=https://foodo.example.ru
# E-mail for the Let's Encrypt account (certificate expiry notices), or "internal" for a test certificate
FOODO_TLS=admin@example.ru
FOODO_APP_NAME=Foodo
# Image tag published by the release workflow (ghcr.io/<owner>/foodo-api and foodo-web)
FOODO_IMAGE_OWNER=lucky2356
FOODO_IMAGE_TAG=0.1.0

# --- Django ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=foodo.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://foodo.example.ru
DJANGO_HSTS_SECONDS=31536000

# --- PostgreSQL (not published to the internet) ---
POSTGRES_DB=foodo
POSTGRES_USER=foodo
POSTGRES_PASSWORD=change-me-too
DATABASE_URL=postgres://foodo:change-me-too@db:5432/foodo

# --- Mail for password reset (SMTP is required in production) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.ru
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Port 587: EMAIL_USE_TLS=1 (STARTTLS); port 465: EMAIL_USE_SSL=1 and EMAIL_USE_TLS=0
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Foodo <noreply@foodo.example.ru>

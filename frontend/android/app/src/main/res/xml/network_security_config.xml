<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificate authorities only (no user-installed CAs). The app's own pages are
     served by Capacitor from https://localhost inside the process, not over the network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

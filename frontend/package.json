{
  "name": "foodo-frontend",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.2.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:static": "tsc --noEmit -p tsconfig.json && vite build --mode static",
    "build:android": "tsc --noEmit -p tsconfig.json && vite build --mode android && cap sync android",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures:write": "FOODO_WRITE_FIXTURES=1 vitest run src/engine/__tests__/parity.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@fontsource-variable/onest": "5.3.1",
    "exceljs": "4.4.0",
    "idb": "8.0.4",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "glob": "14.0.3",
    "exceljs": {
      "uuid": "11.1.1",
      "minimatch": "11.0.3"
    }
  }
}
